# ---------------------------------------------------------------------------
# StudyPack AI configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Provider routing: "ollama" or "gemini"
DEFAULT_PROVIDER=ollama
FALLBACK_PROVIDER=ollama

# Local inference (Ollama). Tag verified on ollama.com/library/qwen3.5 (Nov 2026).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Qwen3.5 supports a "thinking" mode; disabled by default for speed on 6 GB GPUs.
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=600
OLLAMA_KEEP_ALIVE=10m

# Cloud inference (Gemini). Leave the key empty to run fully local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=120

# Generation limits (tuned for RTX 3050 6 GB / 16 GB RAM)
MAX_CONCURRENT_REQUESTS=1
DEFAULT_CONTEXT_LENGTH=8192
MAX_OUTPUT_TOKENS=3072
TEMPERATURE=0.3
MAX_VALIDATION_RETRIES=2

# Ingestion
MAX_UPLOAD_MB=50
CHUNK_TARGET_CHARS=1400
OCR_ENABLED=true
# Full path to tesseract.exe if it's not on PATH, e.g. tools\tesseract\tesseract.exe
TESSERACT_CMD=

# Storage (relative paths are resolved against the project root)
DATA_DIR=data
GENERATED_DIR=generated
LOGS_DIR=logs
DB_PATH=data/studypack.db
LOG_LEVEL=INFO
